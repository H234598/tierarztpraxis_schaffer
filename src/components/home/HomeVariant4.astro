---
import OpeningHours from "../OpeningHours.astro";
import OsmMap from "../OsmMap.astro";
import {
  sharedServicePlaceholderCards,
  variant4HomeCopy,
} from "../../content/home-content";
import { siteConfig } from "../../config/site";
import { withBase } from "../../utils/paths";
---

<section class="home-4__hero" aria-labelledby="home-4-hero-heading">
  <div class="container home-4__hero-shell">
    <div class="home-4__hero-grid">
      <div class="home-4__hero-copy">
        <p class="eyebrow">{variant4HomeCopy.hero.eyebrow}</p>
        <h1 id="home-4-hero-heading">{variant4HomeCopy.hero.title}</h1>
        <p class="home-4__hero-accent">{variant4HomeCopy.hero.accent}</p>
        <p class="home-4__hero-intro">{variant4HomeCopy.hero.intro}</p>
        <a class="button home-4__hero-cta" href={siteConfig.phone.href}>
          Anrufen: {siteConfig.phone.display}
        </a>
      </div>

      <div class="home-4__hero-media">
        <figure class="home-4__hero-figure">
          <img
            class="home-4__hero-image"
            src={withBase("images/home/variant-4/hero-hund-katze.webp")}
            alt=""
            width="1920"
            height="1080"
            fetchpriority="high"
          />
          <figcaption>Symbolbild</figcaption>
        </figure>

        <aside class="home-4__opening-card" aria-labelledby="home-4-opening-heading">
          <p class="eyebrow">Gut vorbereitet</p>
          <h2 id="home-4-opening-heading">Öffnungszeiten</h2>
          <OpeningHours />
        </aside>
      </div>
    </div>

    <nav class="home-4__quick-links" aria-label="Schnellzugriffe">
      <a href={withBase("kontakt/")}>Kontakt</a>
      <a class="home-4__quick-link--urgent" href={withBase("notfall/")}>Notfall</a>
      <a href={withBase("faq/")}>FAQ</a>
      <a href={withBase("stellenangebote/")}>Stellenangebote</a>
    </nav>
  </div>
</section>

<section class="home-4__services section" aria-labelledby="home-4-services-heading">
  <div class="container">
    <header class="home-4__section-heading">
      <p class="eyebrow">Für Ihr Tier</p>
      <h2 id="home-4-services-heading">Leistungen</h2>
    </header>
    <div class="home-4__service-grid">
      {
        sharedServicePlaceholderCards.map((card) => (
          <article>
            <h3>{card.title}</h3>
            <p>{card.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="home-4__practice section">
  <div class="container home-4__practice-band">
    <div>
      <p class="eyebrow">Vor Ort</p>
      <h2>Praxis und Zugänglichkeit</h2>
      <p>{siteConfig.accessibility.faqAnswer}</p>
    </div>
    <div class="home-4__practice-links">
      <a href={withBase("praxis/")}>Praxisangaben ansehen</a>
      <a href={withBase("barrierefreiheit/")}>Erklärung lesen</a>
    </div>
  </div>
</section>

<section class="home-4__orientation section">
  <div class="container home-4__orientation-grid">
    <div class="home-4__info-grid">
      <article>
        <p class="eyebrow">Gut informiert</p>
        <h2>Häufige Fragen</h2>
        <p>
          Antworten zu Terminen, Notfällen, Anfahrt, Dokumenten und Barrierefreiheit.
        </p>
        <a href={withBase("faq/")}>FAQ öffnen</a>
      </article>
      <article>
        <p class="eyebrow">Arbeiten in der Praxis</p>
        <h2>Stellenangebote</h2>
        <p>Aktuelle Ausschreibungen und der künftige sichere Bewerbungsweg.</p>
        <a href={withBase("stellenangebote/")}>Stellenangebote ansehen</a>
      </article>
    </div>
    <OsmMap />
  </div>
</section>

<section class="home-4__phone-cta section" aria-labelledby="home-4-phone-heading">
  <div class="container home-4__phone-cta-inner">
    <div>
      <p class="eyebrow">Direkter Kontakt</p>
      <h2 id="home-4-phone-heading">Wir sind telefonisch für Sie da</h2>
      <p>{siteConfig.appointmentNote}</p>
    </div>
    <a class="button" href={siteConfig.phone.href}>{siteConfig.phone.display} anrufen</a
    >
  </div>
</section>
