---
import { siteConfig } from "../config/site";
import { withBase } from "../utils/paths";
---

<section id="kontaktformular" class="contact-form-section" aria-labelledby="contact-form-heading">
  <header class="section-heading">
    <p class="eyebrow">Schreiben Sie uns</p>
    <h2 id="contact-form-heading">Kontaktformular</h2>
    <p>
      Für Notfälle rufen Sie bitte unmittelbar unter
      <a href={siteConfig.phone.href}>{siteConfig.phone.display}</a> an.
      Datei-Uploads, Befunde und Röntgenbilder werden nicht angenommen.
    </p>
  </header>

  <form class="contact-form" data-contact-form data-endpoint={siteConfig.contactApiUrl}>
    <div class="form-grid">
      <label>
        <span>Name <span aria-hidden="true">*</span></span>
        <input name="name" type="text" autocomplete="name" minlength="2" maxlength="120" required />
      </label>
      <label>
        <span>E-Mail-Adresse</span>
        <input name="email" type="email" autocomplete="email" maxlength="254" />
      </label>
      <label>
        <span>Telefonnummer</span>
        <input name="phone" type="tel" autocomplete="tel" maxlength="40" />
      </label>
      <label>
        <span>Anliegen <span aria-hidden="true">*</span></span>
        <select name="category" required>
          <option value="">Bitte auswählen</option>
          <option value="appointment">Terminanfrage</option>
          <option value="general">Allgemeine Frage</option>
          <option value="feedback">Rückmeldung zur Website</option>
          <option value="accessibility">Barriere melden</option>
          <option value="other">Sonstiges</option>
        </select>
      </label>
    </div>

    <label>
      <span>Nachricht <span aria-hidden="true">*</span></span>
      <textarea name="message" rows="7" minlength="10" maxlength="2000" required></textarea>
      <small>Maximal 2.000 Zeichen. Bitte keine sensiblen medizinischen Dokumente einfügen.</small>
    </label>

    <div class="bot-field" aria-hidden="true">
      <label for="company-website">Website</label>
      <input id="company-website" name="companyWebsite" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <input type="hidden" name="startedAt" value="" data-started-at />

    <label class="checkbox-label">
      <input name="privacyAccepted" type="checkbox" value="true" required />
      <span>
        Ich habe die <a href={withBase("datenschutz/")}>Datenschutzhinweise</a> zur Kenntnis genommen.
        <span aria-hidden="true">*</span>
      </span>
    </label>

    <div class="cf-turnstile" data-sitekey={siteConfig.turnstileSiteKey} data-action="contact_form" data-theme="light"></div>
    <button class="button" type="submit">Nachricht senden</button>
    <p class="form-status" role="status" aria-live="polite" data-form-status></p>
  </form>
</section>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  const status = form?.querySelector<HTMLElement>("[data-form-status]");
  const startedAt = form?.querySelector<HTMLInputElement>("[data-started-at]");

  function resetStartedAt(): void {
    if (startedAt) startedAt.value = String(Date.now());
  }

  resetStartedAt();

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!status) return;

    const data = new FormData(form);
    const email = String(data.get("email") ?? "").trim();
    const phone = String(data.get("phone") ?? "").trim();
    const token = String(data.get("cf-turnstile-response") ?? "");

    if (!email && !phone) {
      status.textContent = "Bitte geben Sie eine E-Mail-Adresse oder Telefonnummer an.";
      return;
    }
    if (!token) {
      status.textContent = "Bitte schließen Sie die Sicherheitsprüfung ab.";
      return;
    }

    const button = form.querySelector<HTMLButtonElement>("button[type='submit']");
    if (button) button.disabled = true;
    status.textContent = "Nachricht wird sicher versendet …";

    const payload = {
      name: String(data.get("name") ?? ""),
      email,
      phone,
      category: String(data.get("category") ?? ""),
      message: String(data.get("message") ?? ""),
      companyWebsite: String(data.get("companyWebsite") ?? ""),
      privacyAccepted: data.get("privacyAccepted") === "true",
      startedAt: Number(data.get("startedAt") ?? 0),
      turnstileToken: token,
    };

    try {
      const endpoint = form.dataset.endpoint;
      if (!endpoint) throw new Error("missing_endpoint");
      const response = await fetch(endpoint, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(payload),
      });
      const result = await response.json().catch(() => ({})) as { accepted?: boolean; error?: string };
      if (!response.ok || !result.accepted) throw new Error(result.error ?? "request_failed");

      form.reset();
      resetStartedAt();
      window.turnstile?.reset();
      status.textContent = "Vielen Dank. Ihre Nachricht wurde angenommen. Eine Terminanfrage ist erst nach Rückmeldung der Praxis bestätigt.";
    } catch {
      window.turnstile?.reset();
      status.textContent = "Die Nachricht konnte gerade nicht gesendet werden. Bitte versuchen Sie es später erneut oder rufen Sie uns an.";
    } finally {
      if (button) button.disabled = false;
    }
  });
</script>
