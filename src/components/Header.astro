---
import { siteConfig } from "../config/site";
import { homeVariants } from "../content/home-variants";
import { withBase } from "../utils/paths";
import StartVariantMenu from "./StartVariantMenu.astro";

const navigation = [
  ["Leistungen", "leistungen/"],
  ["Praxis", "praxis/"],
  ["Sprechzeiten", "sprechzeiten/"],
  ["Notfall", "notfall/"],
  ["FAQ", "faq/"],
  ["Stellenangebote", "stellenangebote/"],
  ["Kontakt", "kontakt/"],
] as const;
const currentPath = Astro.url.pathname;
const isCurrent = (path: string) => currentPath === path;
---

<header class="site-header">
  <div class="contact-strip">
    <div class="container contact-strip__inner">
      <span>Tierarztpraxis in Fürth</span>
      <a
        class="phone-link"
        href={siteConfig.phone.href}
        aria-label={`${siteConfig.shortName} unter ${siteConfig.phone.display} anrufen`}
      >
        <span aria-hidden="true">☎</span>
        {siteConfig.phone.display}
      </a>
    </div>
  </div>

  <div class="container header-main">
    <a class="brand" href={withBase("")} aria-label="Zur Startseite">
      <img src={withBase("logo.svg")} width="72" height="72" alt="" />
      <span>
        <strong>Tierarztpraxis</strong>
        <span>Dr. Schäffer</span>
      </span>
    </a>

    <details class="mobile-menu">
      <summary>Menü</summary>
      <nav aria-label="Hauptnavigation mobil">
        <ul>
          <li>
            <a href={withBase("")}>Start</a>
            <ul data-start-variants>
              {
                homeVariants.map((variant) => (
                  <li>
                    <a
                      href={withBase(variant.route)}
                      aria-current={
                        isCurrent(withBase(variant.route)) ||
                        (variant.isDefault && isCurrent(withBase("")))
                          ? "page"
                          : undefined
                      }
                    >
                      {variant.label}
                      {variant.isDefault && (
                        <span class="start-variant-menu__standard">Standard</span>
                      )}
                    </a>
                  </li>
                ))
              }
            </ul>
          </li>
          {
            navigation.map(([label, path]) => (
              <li>
                <a href={withBase(path)}>{label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>

    <nav class="desktop-nav" aria-label="Hauptnavigation">
      <ul>
        <StartVariantMenu currentPath={currentPath} />
        {
          navigation.map(([label, path]) => (
            <li>
              <a href={withBase(path)}>{label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
