<section class="transfer-card transfer-thread" aria-labelledby="transfer-thread-heading">
  <header class="transfer-heading">
    <p class="eyebrow">Sicherer Fall</p>
    <h2 data-case-heading>Fall</h2>
    <p data-case-reference hidden></p>
  </header>

  <dl class="transfer-case-facts">
    <div><dt>Status</dt><dd data-case-status>Offen</dd></div>
    <div><dt>Gültig bis</dt><dd data-case-expiry>–</dd></div>
    <div><dt>Verbleibende Einreichungen</dt><dd data-case-submissions>–</dd></div>
    <div><dt>Verbleibendes Volumen</dt><dd data-case-bytes>–</dd></div>
  </dl>

  <div class="transfer-thread__history">
    <h2 id="transfer-thread-heading" tabindex="-1" data-thread-heading>Bisheriger Verlauf</h2>
    <p data-thread-empty>Noch keine Einreichungen oder Praxisantworten.</p>
    <ol class="transfer-thread-list" data-transfer-thread></ol>
  </div>
</section>
